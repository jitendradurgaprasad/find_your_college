# Supabase Database & Auth (Optional - falls back to SQLite locally)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./find_your_college.db

# Search Engine Provider Configuration (Tavily, Brave, or manual fallback)
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily

# Backend API Configuration
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
CRAWLER_API_SECRET=change-this-in-production-crawler-key

# AI-Assisted Extraction (Optional - rule-based extraction works without key)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Crawler & Worker Settings
MAX_CRAWL_DEPTH=3
MAX_PAGES_PER_SITE=30
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=15
MAX_CONCURRENT_REQUESTS=5
USER_AGENT=FindYourCollageBot/1.0 (+https://find-your-college.edu/bot; educational discovery crawler)
